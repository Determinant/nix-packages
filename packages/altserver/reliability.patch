@@ -0,0 +1,75 @@
+#include "WirelessConnection.h"
+#include "ServerError.hpp"
+
+#include <cerrno>
+#include <chrono>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+namespace {
+// An idle peer must release its worker even when the app never closes its socket.
+void WaitForSocket(int fd, short events, std::chrono::steady_clock::time_point deadline)
+{
+    for (;;) {
+        auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
+            deadline - std::chrono::steady_clock::now()).count();
+        if (remaining <= 0) throw ServerError(ServerErrorCode::LostConnection);
+        pollfd descriptor{fd, events, 0};
+        int result = poll(&descriptor, 1, static_cast<int>(remaining));
+        if (result < 0 && errno == EINTR) continue;
+        if (result <= 0 || (descriptor.revents & POLLNVAL))
+            throw ServerError(ServerErrorCode::LostConnection);
+        // POLLHUP may accompany the final readable bytes. recv handles EOF.
+        return;
+    }
+}
+}
+
+WirelessConnection::WirelessConnection(int socket, std::chrono::milliseconds sendTimeout)
+    : _socket(socket), _sendTimeout(sendTimeout) {}
+WirelessConnection::~WirelessConnection() { Disconnect(); }
+
+void WirelessConnection::Disconnect()
+{
+    if (_socket < 0) return;
+    close(_socket);
+    _socket = -1;
+}
+
+pplx::task<void> WirelessConnection::SendData(std::vector<unsigned char>& data)
+{
+    return pplx::create_task([this, data]() {
+        auto deadline = std::chrono::steady_clock::now() + _sendTimeout;
+        size_t offset = 0;
+        while (offset < data.size()) {
+            WaitForSocket(_socket, POLLOUT, deadline);
+            ssize_t count = send(_socket, data.data() + offset, data.size() - offset,
+                                 MSG_NOSIGNAL | MSG_DONTWAIT);
+            if (count < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) continue;
+            if (count <= 0) throw ServerError(ServerErrorCode::LostConnection);
+            offset += static_cast<size_t>(count);
+        }
+    });
+}
+
+pplx::task<std::vector<unsigned char>> WirelessConnection::ReceiveData(int size)
+{
+    return pplx::create_task([this, size]() {
+        if (size < 0) throw ServerError(ServerErrorCode::UnknownRequest);
+        std::vector<unsigned char> data;
+        data.reserve(size);
+        unsigned char buffer[65536];
+        while (data.size() < static_cast<size_t>(size)) {
+            WaitForSocket(_socket, POLLIN, std::chrono::steady_clock::now() + std::chrono::seconds(60));
+            ssize_t count = recv(_socket, buffer,
+                std::min(sizeof(buffer), static_cast<size_t>(size) - data.size()), MSG_DONTWAIT);
+            if (count < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) continue;
+            if (count <= 0) throw ServerError(ServerErrorCode::LostConnection);
+            data.insert(data.end(), buffer, buffer + count);
+        }
+        return data;
+    });
+}
+
+int WirelessConnection::socket() const { return _socket; }
