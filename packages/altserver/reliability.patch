+#pragma once
+#include <optional>
+#include <set>
+#include <string>
+
+// Without an active-app list (CLI installs), there is no evidence that an
+// existing profile is inactive. Let iOS enforce its ordinary app limit.
+inline std::optional<std::set<std::string>> ProfilesToPreserve(
+    const std::optional<std::set<std::string>>& active,
+    const std::set<std::string>& incoming, const std::string& application)
+{
+    if (!active) return std::nullopt;
+    // AltStore can install an app as inactive while all active slots are full.
+    // Keep upstream's temporary removal/restoration path for that operation.
+    if (!active->count(application)) return std::set<std::string>{};
+    auto preserved = *active;
+    preserved.insert(incoming.begin(), incoming.end());
+    return preserved;
+}
